{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibemate",
  "version": "0.3.0",
  "identifier": "kr.tg.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vibemate",
        "width": 1100,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data: https:; connect-src 'self' https://tg-backend.mickeys67.workers.dev https://*.posthog.com https://*.sentry.io"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4N0IyMUQ1MDZFMDIyMUQKUldRZEl1QUcxU0Y3U0tYY1dCNVpYZmVGemhTUmpIZnZydFV0VEwveTNWUE92cnZCOE5PSUlLNUwK",
      "endpoints": [
        "https://tg-backend.mickeys67.workers.dev/updates/{{target}}/{{current_version}}"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/coach/tg-coach-stop.mjs": "coach/tg-coach-stop.mjs"
    },
    "category": "DeveloperTool",
    "shortDescription": "바이브코딩 입문자를 위한 통합 가디언",
    "longDescription": "컴퓨터 켠 첫 순간부터 첫 앱 배포까지 끊김 없이 안내하는 데스크톱 가디언.",
    "publisher": "Vibemate",
    "copyright": "© 2026 Vibemate",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["ko-KR", "en-US"]
      },
      "nsis": {
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": []
    }
  }
}
