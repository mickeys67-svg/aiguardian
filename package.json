{
  "name": "tg-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal Guardian (TG) — vibe-coding 입문자 통합 가디언",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @tg/desktop tauri dev",
    "build": "pnpm --filter @tg/desktop tauri build",
    "lint": "pnpm -r --parallel lint",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "stance-lint": "node scripts/stance-lint.mjs",
    "mock-scan": "node scripts/mock-scan.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
