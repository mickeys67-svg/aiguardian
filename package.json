{
  "name": "vibemate-monorepo",
  "version": "0.2.5",
  "private": true,
  "description": "Vibemate — 바이브코딩 입문자를 위한 통합 가디언",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @tg/desktop tauri dev",
    "build": "pnpm --filter @tg/desktop tauri build",
    "lint": "pnpm -r --parallel lint",
    "lint:recipes": "node scripts/lint-recipes.mjs",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
